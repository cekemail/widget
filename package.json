{
  "name": "@cekemail/widget",
  "version": "1.2.2",
  "type": "module",
  "description": "Email validation widget for CekEmail - validates email addresses in real-time on your website",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "browser": "dist/index.umd.min.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.umd.min.js",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "email",
    "validation",
    "widget",
    "cekemail",
    "email-validation",
    "form-validation"
  ],
  "author": "CekEmail",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cekemail/widget.git"
  },
  "homepage": "https://cekemail.com",
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^22.13.1",
    "@vitest/coverage-v8": "^3.0.4",
    "jsdom": "^26.0.0",
    "rollup": "^4.34.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
